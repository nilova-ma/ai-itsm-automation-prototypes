    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item;\nconst aiData = item.json.output[0].content[0].text;\nconst rowId = $('Code in JavaScript1').item.json.ID;\n\n// Сохраняем очищенное описание из первой ноды\nconst cleanedDesc = $('Code in JavaScript1').item.json.Очищенное_описание;\n\nitem.json.category = aiData.category;\nitem.json.priority = aiData.priority;\nitem.json.team = aiData.team;\nitem.json.status = \"AI Маршрутизирован\";\nitem.json.ID = String(rowId);\nitem.json.Очищенное_описание = cleanedDesc; //  ДОБАВИТЬ ЭТУ СТРОКУ\n\nreturn item;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
